<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Instalar a atualização baixada; o sistema ainda pede a confirmação. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Televisão primeiro: sem toque, tudo pelo controle. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".SaimoApp"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/Theme.Saimo"
        android:usesCleartextTraffic="true">

        <!-- A abertura: TV ao vivo ou filmes e séries. É ela que o sistema
             abre; os canais deixaram de ser a primeira tela. -->
        <activity
            android:name=".EscolhaActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Saimo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape" />
        <activity
            android:name=".VodActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:theme="@style/Theme.Saimo" />
        <activity
            android:name=".FichaActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Saimo" />
        <activity
            android:name=".AtorActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Saimo" />
        <!-- O sistema responde aqui quando a instalação precisa da confirmação
             de quem está assistindo. -->
        <receiver
            android:name=".InstaladorReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="br.com.saimo.tv.INSTALADO" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".GuideActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Saimo" />
    </application>
</manifest>
