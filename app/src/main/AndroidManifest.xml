<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Instalar a atualização baixada; o sistema ainda pede a confirmação. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- "Continuar assistindo" e a fileira do Saimo na tela inicial da TV. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- Televisão primeiro: sem toque, tudo pelo controle. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".SaimoApp"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/Theme.Saimo"
        android:usesCleartextTraffic="true">
        <!-- Meta Quest / Meta VR Glasses: o app se declara compatível (Vr.kt
             liga os controles de toque lá). TV Box ignora. -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|questpro|quest3|quest3s" />
        <meta-data
            android:name="android.app.default_searchable"
            android:value=".EscolhaActivity" />

        <!-- A abertura: TV ao vivo ou filmes e séries. É ela que o sistema
             abre; os canais deixaram de ser a primeira tela. -->
        <activity
            android:name=".EscolhaActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Saimo">
            <!-- Janela no Horizon OS e demais óculos; TV Box ignora. -->
            <layout android:defaultWidth="1024dp" android:defaultHeight="640dp"
                android:minWidth="720dp" android:minHeight="405dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Links saimo:// da tela inicial da TV e da busca do sistema. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="saimo" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/busca" />
        </activity>
        <activity
            android:name=".PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Saimo">
            <!-- Janela no Horizon OS e demais óculos; TV Box ignora. -->
            <layout android:defaultWidth="1024dp" android:defaultHeight="640dp"
                android:minWidth="720dp" android:minHeight="405dp" />
        </activity>
        <activity
            android:name=".AjustesActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Saimo">
            <!-- Janela no Horizon OS e demais óculos; TV Box ignora. -->
            <layout android:defaultWidth="1024dp" android:defaultHeight="640dp"
                android:minWidth="720dp" android:minHeight="405dp" />
        </activity>
        <provider
            android:name=".BuscaDoSistema"
            android:authorities="br.com.saimo.tv.busca"
            android:exported="true" />
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape">
            <!-- Janela no Horizon OS e demais óculos; TV Box ignora. -->
            <layout android:defaultWidth="1024dp" android:defaultHeight="640dp"
                android:minWidth="720dp" android:minHeight="405dp" />
        </activity>
        <activity
            android:name=".GradeActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Saimo">
            <!-- Janela no Horizon OS e demais óculos; TV Box ignora. -->
            <layout android:defaultWidth="1024dp" android:defaultHeight="640dp"
                android:minWidth="720dp" android:minHeight="405dp" />
        </activity>
        <activity
            android:name=".PaginaActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Saimo">
            <!-- Janela no Horizon OS e demais óculos; TV Box ignora. -->
            <layout android:defaultWidth="1024dp" android:defaultHeight="640dp"
                android:minWidth="720dp" android:minHeight="405dp" />
        </activity>
        <activity
            android:name=".BuscaActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:theme="@style/Theme.Saimo">
            <!-- Janela no Horizon OS e demais óculos; TV Box ignora. -->
            <layout android:defaultWidth="1024dp" android:defaultHeight="640dp"
                android:minWidth="720dp" android:minHeight="405dp" />
        </activity>
        <activity
            android:name=".FichaActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Saimo">
            <!-- Janela no Horizon OS e demais óculos; TV Box ignora. -->
            <layout android:defaultWidth="1024dp" android:defaultHeight="640dp"
                android:minWidth="720dp" android:minHeight="405dp" />
        </activity>
        <activity
            android:name=".AtorActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Saimo">
            <!-- Janela no Horizon OS e demais óculos; TV Box ignora. -->
            <layout android:defaultWidth="1024dp" android:defaultHeight="640dp"
                android:minWidth="720dp" android:minHeight="405dp" />
        </activity>
        <!-- O sistema responde aqui quando a instalação precisa da confirmação
             de quem está assistindo. -->
        <receiver
            android:name=".InstaladorReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="br.com.saimo.tv.INSTALADO" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".GuideActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Saimo">
            <!-- Janela no Horizon OS e demais óculos; TV Box ignora. -->
            <layout android:defaultWidth="1024dp" android:defaultHeight="640dp"
                android:minWidth="720dp" android:minHeight="405dp" />
        </activity>
    </application>
</manifest>
