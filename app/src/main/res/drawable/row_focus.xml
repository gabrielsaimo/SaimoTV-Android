<?xml version="1.0" encoding="utf-8"?>
<!-- Três estados legíveis a três metros: focado (ciano), sintonizado mas sem
     foco (leve), e o resto transparente. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_dim" />
            <stroke android:width="2dp" android:color="@color/accent_edge" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_raised" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
