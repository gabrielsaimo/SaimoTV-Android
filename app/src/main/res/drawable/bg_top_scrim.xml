<?xml version="1.0" encoding="utf-8"?>
<!-- Espelho da faixa de baixo: escurece o topo para o texto ler sobre qualquer
     cena, e se dissolve na imagem em vez de virar uma barra. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F2000000"
        android:centerColor="#A6000000"
        android:endColor="#00000000"
        android:type="linear" />
</shape>
