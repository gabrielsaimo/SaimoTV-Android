<?xml version="1.0" encoding="utf-8"?>
<!-- O fundo da abertura: quase preto, com uma luz ciano vindo de cima — a cor
     do ícone, sem competir com os dois cartões. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0"
                android:gradientRadius="900dp"
                android:startColor="#2A4FE3D0"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
