<?xml version="1.0" encoding="utf-8"?>
<!-- Os dois cartões da abertura. Focado: contorno ciano grosso e fundo mais
     claro, legível do outro lado da sala. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#334FE3D0"
                android:endColor="#1AFFFFFF" />
            <stroke android:width="4dp" android:color="@color/accent" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
