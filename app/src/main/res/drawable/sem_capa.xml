<?xml version="1.0" encoding="utf-8"?>
<!-- O lugar da capa quando o título não tem ficha no TMDB.
     Uma moldura com um risco: diz "aqui não há imagem" sem fingir que há. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:gravity="center">
        <rotate android:fromDegrees="-32" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="rectangle">
                <size android:width="72dp" android:height="2dp" />
                <solid android:color="#40FFFFFF" />
            </shape>
        </rotate>
    </item>
</layer-list>
