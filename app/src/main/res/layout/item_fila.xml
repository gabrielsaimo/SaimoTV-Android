<?xml version="1.0" encoding="utf-8"?>
<!-- Uma fileira da tela inicial: o nome dela e as capas correndo para o lado.

     O foco entra pelas capas, nunca pela fileira: quem está no controle anda
     para os lados dentro da fileira e para cima e para baixo entre elas, que é
     como toda TV se comporta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="afterDescendants"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/filaTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/filaCapas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:focusable="false"
        android:paddingStart="18dp"
        android:paddingEnd="18dp" />
</LinearLayout>
