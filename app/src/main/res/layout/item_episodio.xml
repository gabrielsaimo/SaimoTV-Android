<?xml version="1.0" encoding="utf-8"?>
<!-- Um episódio na ficha: imagem da cena, número e nome, quanto já foi visto. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:background="@drawable/row_focus"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="6dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="162dp"
        android:background="@drawable/bg_logo">
        <TextView
            android:id="@+id/epNumeroGrande"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="40sp" />
        <ImageView
            android:id="@+id/epImagem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
        <TextView
            android:id="@+id/epVisto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_card"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="✓ visto"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/epProgresso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progressDrawable="@drawable/progress_track"
            android:visibility="gone" />
    </FrameLayout>
    <TextView
        android:id="@+id/epTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="17sp" />
    <TextView
        android:id="@+id/epDetalhe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
</LinearLayout>
