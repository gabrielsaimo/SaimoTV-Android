<?xml version="1.0" encoding="utf-8"?>
<!-- Episódios dentro do player: a faixa de baixo da tela, com as temporadas em
     pílulas no alto e os episódios em cartões com a imagem da cena. O vídeo
     continua tocando acima dela. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_painel_episodios"
    android:orientation="vertical"
    android:paddingTop="72dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:id="@+id/peCabecalho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingEnd="48dp">
        <TextView
            android:id="@+id/peTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="26sp" />
        <TextView
            android:id="@+id/peSubtitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/peTemporadasRolagem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/peTemporadas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/peLista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:paddingStart="42dp"
        android:paddingEnd="42dp" />

    <TextView
        android:id="@+id/peDica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:text="@string/player_eps_dica"
        android:textColor="@color/text_faint"
        android:textSize="15sp" />
</LinearLayout>
