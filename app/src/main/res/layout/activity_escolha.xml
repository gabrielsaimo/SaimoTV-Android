<?xml version="1.0" encoding="utf-8"?>
<!-- A abertura: TV ao vivo ou filmes e séries.

     Antes o app abria direto no canal, e quem queria um filme esperava o canal
     conectar só para sair dele. Dois cartões grandes, lado a lado, o foco já
     no que a pessoa escolheu da última vez — um OK e ela está onde queria. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_escolha"
    android:clipChildren="false">

    <!-- clipChildren desligado: o cartão cresce no foco e não pode ser
         cortado pela borda de quem o contém. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingEnd="64dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/escolha_titulo"
            android:textColor="@color/text_primary"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/escolhaSaudacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/escolhaTv"
                android:layout_width="340dp"
                android:layout_height="260dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/cartao_escolha"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusRight="@+id/escolhaFilmes"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_escolha_tv" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/escolha_tv"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/escolhaTvDetalhe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/escolha_tv_dica"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/escolhaFilmes"
                android:layout_width="340dp"
                android:layout_height="260dp"
                android:background="@drawable/cartao_escolha"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/escolhaTv"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_escolha_filme" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/escolha_filmes"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/escolhaFilmesDetalhe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/escolha_filmes_dica"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Andamento do download da versão nova, quando houver. -->
    <TextView
        android:id="@+id/escolhaStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_card"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/escolhaVersao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:textColor="@color/text_faint"
        android:textSize="13sp" />
</FrameLayout>
