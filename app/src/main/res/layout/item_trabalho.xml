<?xml version="1.0" encoding="utf-8"?>
<!-- Uma capa na filmografia: o pôster, o nome e o papel da pessoa nele.

     Largura pela coluna, altura pela proporção 2:3 do pôster: a grade não pula
     enquanto as imagens chegam. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/row_focus"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/trabalhoQuadro"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@drawable/bg_logo">

        <TextView
            android:id="@+id/trabalhoInicial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="30sp" />

        <ImageView
            android:id="@+id/trabalhoCapa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/trabalhoNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/trabalhoPapel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_faint"
        android:textSize="11sp" />
</LinearLayout>
