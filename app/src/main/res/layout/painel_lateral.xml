<?xml version="1.0" encoding="utf-8"?>
<!-- Painel de opções no estilo da TV: título, lista, dica. Substitui os
     diálogos de celular, pequenos demais para ler do sofá. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="match_parent"
    android:background="@drawable/bg_painel_lateral"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingTop="44dp"
    android:paddingEnd="40dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/painelTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/painelSubtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="17sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/painelLista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/painelDica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/painel_dica"
        android:textColor="@color/text_faint"
        android:textSize="15sp" />
</LinearLayout>
