<?xml version="1.0" encoding="utf-8"?>
<!-- A ficha de um título, na TV.

     A imagem larga do filme ocupa a tela inteira e escurece da esquerda para
     a direita; a ficha fica sobre o escuro, o filme aparece do outro lado.
     Embaixo, o elenco em fotos redondas — o direcional desce do botão
     "Assistir" direto para ele. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/fichaFundo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_ficha_lado" />

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_ficha_baixo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="28dp"
        android:paddingEnd="56dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="152dp"
                android:layout_height="228dp"
                android:background="@drawable/bg_logo">

                <TextView
                    android:id="@+id/fichaInicial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/accent"
                    android:textSize="54sp" />

                <ImageView
                    android:id="@+id/fichaCapa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="34dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fichaTipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.15"
                    android:textAllCaps="true"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/fichaTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/fichaFrase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    android:visibility="gone" />

                <!-- Ano, duração, classificação, nota: preenchidos no código. -->
                <LinearLayout
                    android:id="@+id/fichaSelos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/fichaGeneros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipChildren="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/fichaAssistir"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:background="@drawable/botao_ficha"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:minWidth="190dp"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp"
                        android:textColor="@color/texto_botao_ficha"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/fichaFavoritar"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/botao_ficha"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:textColor="@color/texto_botao_ficha"
                        android:textSize="17sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/fichaSinopse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="3"
                    android:textColor="#E6FFFFFF"
                    android:textSize="15sp" />



            </LinearLayout>
        </LinearLayout>

        <!-- "Elenco" e, na mesma linha, quem dirigiu, escreveu e produziu:
             numa tela de 540dp de altura não sobra linha para os dois. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fichaElencoTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/vod_ficha_elenco"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/fichaCreditos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fichaElenco"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="24dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/fichaCarregando"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="32dp"
        android:indeterminateTint="@color/accent" />
</FrameLayout>
