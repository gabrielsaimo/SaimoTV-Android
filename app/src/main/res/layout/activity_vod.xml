<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:id="@+id/browse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="46dp"
            android:paddingTop="30dp"
            android:paddingEnd="46dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/vodTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/vodContagem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Ferramentas de busca, no alto: o campo primeiro, as seções em
             seguida. Quem chega ao acervo quer uma destas duas coisas, e as
             duas estavam no fim de uma lista que era preciso percorrer. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="46dp"
            android:paddingEnd="46dp"
            android:paddingBottom="14dp">

            <EditText
                android:id="@+id/vodBusca"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_campo"
                android:hint="@string/vod_buscar_dica"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="19sp" />

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/vodSecoes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/vodTrilha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="46dp"
            android:paddingEnd="46dp"
            android:paddingBottom="14dp"
            android:textColor="@color/accent"
            android:textSize="18sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vodLista"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="46dp"
            android:paddingTop="8dp"
            android:paddingEnd="46dp"
            android:paddingBottom="22dp"
            android:text="@string/vod_legenda"
            android:textColor="@color/text_faint"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/vodEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="46dp"
        android:paddingTop="28dp"
        android:paddingEnd="46dp"
        android:paddingBottom="28dp"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:visibility="gone" />




    <!-- O player do VOD tem controle: filme se pausa e se avança, ao contrário
         de canal ao vivo. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/vodPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <!-- Estas três são sobreposições e vêm depois do player de propósito:
         num FrameLayout quem vem por último desenha por cima.

    Ficha do que está tocando, acompanhando a barra de controle: aparece
         com ela e some com ela, para não ficar sobre a imagem o filme inteiro. -->
    <LinearLayout
        android:id="@+id/vodFicha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="56dp"
        android:paddingTop="40dp"
        android:paddingEnd="56dp"
        android:paddingBottom="60dp"
        android:visibility="gone">

        <!-- A capa ao lado do nome: é ela que identifica o filme de longe,
             antes de qualquer texto ser lido. -->
        <FrameLayout
            android:layout_width="92dp"
            android:layout_height="134dp"
            android:layout_marginEnd="22dp"
            android:background="@drawable/bg_logo">

            <ImageView
                android:id="@+id/vodFichaCapa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vodFichaNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/vodFichaDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/vodFichaResolucao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingTop="3dp"
                android:paddingEnd="12dp"
                android:paddingBottom="3dp"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/vodFichaTempo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_faint"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Temporadas e episódios por cima do vídeo, que continua correndo atrás:
         trocar de episódio não deveria custar sair do que se está vendo. -->
    <FrameLayout
        android:id="@+id/vodSeletor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="560dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/bg_painel_direita"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="30dp"
            android:paddingEnd="30dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/vodSeletorSerie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/vodSeletorTemporada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:textColor="@color/accent"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vodSeletorLista"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/vod_seletor_dica"
                android:textColor="@color/text_faint"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Teclado na tela: procurar num controle remoto não tem outro jeito. -->
    <FrameLayout
        android:id="@+id/vodTeclado"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="820dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_modal"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:id="@+id/vodTermo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="@string/vod_buscar_dica"
                android:minHeight="48dp"
                android:textColor="@color/accent"
                android:textColorHint="@color/text_faint"
                android:textSize="32sp" />

            <GridLayout
                android:id="@+id/vodTeclas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="8" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
