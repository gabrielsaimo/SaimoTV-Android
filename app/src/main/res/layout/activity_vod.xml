<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:id="@+id/browse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="46dp"
            android:paddingTop="30dp"
            android:paddingEnd="46dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/vodTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/vodContagem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/vodTrilha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="46dp"
            android:paddingEnd="46dp"
            android:paddingBottom="14dp"
            android:textColor="@color/accent"
            android:textSize="18sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vodLista"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="46dp"
            android:paddingTop="8dp"
            android:paddingEnd="46dp"
            android:paddingBottom="22dp"
            android:text="@string/vod_legenda"
            android:textColor="@color/text_faint"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/vodEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="46dp"
        android:paddingTop="28dp"
        android:paddingEnd="46dp"
        android:paddingBottom="28dp"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:visibility="gone" />

    <!-- O player do VOD tem controle: filme se pausa e se avança, ao contrário
         de canal ao vivo. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/vodPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="true" />
</FrameLayout>
