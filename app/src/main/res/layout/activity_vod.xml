<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:id="@+id/browse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="46dp"
            android:paddingTop="30dp"
            android:paddingEnd="46dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/vodTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/vodContagem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/vodTrilha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="46dp"
            android:paddingEnd="46dp"
            android:paddingBottom="14dp"
            android:textColor="@color/accent"
            android:textSize="18sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vodLista"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="46dp"
            android:paddingTop="8dp"
            android:paddingEnd="46dp"
            android:paddingBottom="22dp"
            android:text="@string/vod_legenda"
            android:textColor="@color/text_faint"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/vodEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="46dp"
        android:paddingTop="28dp"
        android:paddingEnd="46dp"
        android:paddingBottom="28dp"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:visibility="gone" />

    <!-- Teclado na tela: procurar num controle remoto não tem outro jeito. -->
    <FrameLayout
        android:id="@+id/vodTeclado"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="820dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_modal"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:id="@+id/vodTermo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="@string/vod_buscar_dica"
                android:minHeight="48dp"
                android:textColor="@color/accent"
                android:textColorHint="@color/text_faint"
                android:textSize="32sp" />

            <GridLayout
                android:id="@+id/vodTeclas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="8" />
        </LinearLayout>
    </FrameLayout>

    <!-- Ficha do que está tocando, acompanhando a barra de controle: aparece
         com ela e some com ela, para não ficar sobre a imagem o filme inteiro. -->
    <LinearLayout
        android:id="@+id/vodFicha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_scrim"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="40dp"
        android:paddingEnd="56dp"
        android:paddingBottom="60dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/vodFichaNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/vodFichaDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/vodFichaTempo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_faint"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- O player do VOD tem controle: filme se pausa e se avança, ao contrário
         de canal ao vivo. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/vodPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="true" />
</FrameLayout>
