<?xml version="1.0" encoding="utf-8"?>
<!-- Busca: teclado à esquerda, resultados em fileiras à direita, mudando a
     cada letra. Teclado minimiza ao navegar para os catálogos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/buscaRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/buscaPainelTeclado"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:background="#0FFFFFFF"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp">
        <TextView
            android:id="@+id/buscaTermo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_campo"
            android:ellipsize="start"
            android:hint="@string/busca_dica"
            android:maxLines="1"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_faint"
            android:textSize="24sp" />
        <GridLayout
            android:id="@+id/buscaTeclas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="6" />
        <TextView
            android:id="@+id/buscaAjuda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/busca_ajuda"
            android:textColor="@color/text_faint"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Mini header exibido quando o teclado está minimizado -->
        <LinearLayout
            android:id="@+id/buscaMiniHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/buscaVoltarTecladoDica"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀ Teclado"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/item_painel"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/buscaTermoMini"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <br.com.saimo.tv.ListaSemFuga
                android:id="@+id/buscaResultados"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="true"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="80dp" />

            <TextView
                android:id="@+id/buscaEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="22sp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
