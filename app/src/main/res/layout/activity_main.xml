<?xml version="1.0" encoding="utf-8"?>
<!-- Vídeo em tela cheia; tudo o mais é sobreposição que aparece por poucos
     segundos. Nada fica permanentemente por cima da imagem. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:use_controller="false" />

    <!-- Cartão do que está no ar: canal, programa, quanto já passou. -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="56dp"
        android:paddingTop="70dp"
        android:paddingEnd="56dp"
        android:paddingBottom="44dp">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginEnd="22dp"
            android:background="@drawable/bg_logo">

            <ImageView
                android:id="@+id/bannerLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bannerNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/accent"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/bannerChannel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/bannerResolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_chip"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/bannerLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_chip"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp"
                    android:text="@string/live"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/bannerProgramme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="21sp" />

            <ProgressBar
                android:id="@+id/bannerProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_track" />

            <TextView
                android:id="@+id/bannerSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_faint"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bannerTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Estado do canal: ligando, reconectando, número digitado. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="46dp"
        android:paddingTop="28dp"
        android:paddingEnd="46dp"
        android:paddingBottom="28dp"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:visibility="gone" />


    <!-- Lista de canais: entra pela esquerda, navegada no D-pad. -->
    <LinearLayout
        android:id="@+id/listPanel"
        android:layout_width="430dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- O cabeçalho é focável e abre o teclado na tela: há controle sem
             teclas numéricas, e o D-pad com OK é o que todo controle tem. -->
        <LinearLayout
            android:id="@+id/listHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/row_focus"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/channels"
                android:textColor="@color/text_primary"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/keypad"
                android:textColor="@color/accent"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/listCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Entrada para filmes e séries: uma linha só, logo acima dos canais,
             onde o olho já está. -->
        <TextView
            android:id="@+id/vodEntrada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/row_focus"
            android:drawablePadding="14dp"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:text="@string/vod"
            android:textColor="@color/accent"
            android:textSize="20sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="30dp"
            android:paddingTop="10dp"
            android:paddingEnd="30dp"
            android:paddingBottom="26dp"
            android:text="@string/list_legend"
            android:textColor="@color/text_faint"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Teclado na tela, para controle sem teclas numéricas. -->
    <FrameLayout
        android:id="@+id/numpad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:visibility="gone">

    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_modal"
        android:orientation="vertical"
        android:padding="26dp">

        <TextView
            android:id="@+id/numpadValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minHeight="52dp"
            android:textColor="@color/accent"
            android:textSize="38sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pad1"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/row_focus"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/pad2"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/row_focus"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/pad3"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/row_focus"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pad4"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/row_focus"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/pad5"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/row_focus"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/pad6"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/row_focus"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="6"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pad7"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/row_focus"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="7"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/pad8"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/row_focus"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="8"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/pad9"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/row_focus"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="9"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/padDel"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/row_focus"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/pad_delete"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/pad0"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/row_focus"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/padOk"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/row_focus"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/pad_ok"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
