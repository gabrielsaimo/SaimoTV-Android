<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/row_focus"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="78dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <!-- A capa chega da rede quando a linha aparece; até lá, a inicial segura
         o lugar, para a lista não piscar nem mudar de altura. -->
    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="84dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_logo">

        <TextView
            android:id="@+id/vodInicial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/vodCapa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/vodNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="21sp" />

        <ProgressBar
            android:id="@+id/vodProgresso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="14dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_track"
            android:visibility="gone" />

        <TextView
            android:id="@+id/vodDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Fica à direita, fora do caminho do texto: quem não favoritou nada nunca
         vê estrela nenhuma. -->
    <TextView
        android:id="@+id/vodEstrela"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/star"
        android:textColor="@color/accent"
        android:textSize="20sp"
        android:visibility="gone" />
</LinearLayout>
