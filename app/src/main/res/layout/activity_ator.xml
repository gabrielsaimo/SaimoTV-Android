<?xml version="1.0" encoding="utf-8"?>
<!-- Uma pessoa e o que ela tem neste acervo.

     Em cima, numa faixa, quem ela é: a foto, o nome, de onde é, a biografia.
     Embaixo, as capas do que dá para assistir daqui, em quantas colunas
     couberem na tela — e só isso: a filmografia inteira do TMDB, com setenta
     títulos que não abrem, seria uma lista que frustra. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="28dp"
    android:paddingEnd="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="116dp"
            android:layout_height="116dp">

            <ImageView
                android:id="@+id/atorGrandeFoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/sem_foto"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/atorGrandeInicial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="44sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/atorGrandeNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/atorDados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/atorBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="3"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/atorContagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/atorEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- A grade recorta na própria borda: sem isso, as capas que rolam para
         cima eram desenhadas por cima do perfil. A folga interna é onde o
         cartão focado cresce sem ser cortado. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/atorGrade"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="-12dp"
        android:layout_marginEnd="-12dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="32dp" />
</LinearLayout>
